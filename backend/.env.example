# ---------- Base de datos (PostgreSQL) ----------
# Crear antes la base foodstore_db (ver README)
DATABASE_URL=postgresql+psycopg2://postgres:TU_CONTRASEÑA@localhost:5432/foodstore_db

# ---------- JWT ----------
# Mínimo 32 caracteres. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- CORS ----------
# Origen del frontend (Vite)
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Cookie ----------
# En producción con HTTPS: true
COOKIE_SECURE=false